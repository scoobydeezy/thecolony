{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^asset\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "stub",
        "draft",
        "canonical"
      ]
    },
    "previousSlugs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "provenance": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "doc",
          "heading"
        ]
      }
    },
    "design": {
      "type": "string"
    },
    "type": {
      "default": "Infrastructure",
      "type": "string",
      "enum": [
        "Infrastructure",
        "Artifact",
        "Resource",
        "Intelligence"
      ]
    },
    "role": {
      "default": "Operational",
      "type": "string",
      "enum": [
        "Operational",
        "Strategic",
        "Symbolic",
        "Covert",
        "Mandate"
      ]
    },
    "tier": {
      "default": 3,
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "keystone": {
      "default": false,
      "type": "boolean"
    },
    "start": {
      "type": "object",
      "properties": {
        "controller": {
          "type": "string",
          "pattern": "^faction\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "location": {
          "type": "string",
          "pattern": "^location\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "status": {
          "default": "Stable",
          "type": "string",
          "enum": [
            "Stable",
            "Contested",
            "Damaged",
            "Destroyed"
          ]
        },
        "statusActor": {
          "type": "string",
          "pattern": "^faction\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "slug",
    "name"
  ],
  "additionalProperties": false
}
