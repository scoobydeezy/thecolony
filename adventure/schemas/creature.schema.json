{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^creature\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "status": {
      "default": "draft",
      "type": "string",
      "enum": [
        "stub",
        "draft",
        "canonical"
      ]
    },
    "previousSlugs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "aliases": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z]+\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      }
    },
    "provenance": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "doc": {
            "type": "string"
          },
          "heading": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "doc",
          "heading"
        ]
      }
    },
    "design": {
      "type": "string"
    },
    "level": {
      "type": "integer",
      "minimum": -1,
      "maximum": 25
    },
    "rarity": {
      "default": "common",
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "unique"
      ]
    },
    "size": {
      "type": "string",
      "enum": [
        "Tiny",
        "Small",
        "Medium",
        "Large",
        "Huge",
        "Gargantuan",
        "Small or Medium"
      ]
    },
    "traits": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "perception": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "senses": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skills": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "ac": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "saves": {
      "type": "object",
      "properties": {
        "fort": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "ref": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "will": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "fort",
        "ref",
        "will"
      ]
    },
    "hp": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "immunities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resistances": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "weaknesses": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "speed": {
      "type": "string"
    },
    "strikes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "default": "melee",
            "type": "string",
            "enum": [
              "melee",
              "ranged"
            ]
          },
          "bonus": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "damage": {
            "type": "string"
          },
          "traits": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "bonus",
          "damage"
        ]
      }
    },
    "abilityDC": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "npc": {
      "type": "string",
      "pattern": "^npc\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "variant": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "slug",
    "size",
    "perception",
    "ac",
    "saves",
    "hp",
    "speed"
  ],
  "additionalProperties": false
}
