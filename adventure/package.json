{
  "name": "colony-adventure",
  "private": true,
  "type": "module",
  "description": "Results Pending — canonical campaign content and the Starlight adventure book served at /docs/.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "dev": "astro dev --force",
    "dev:designer": "node scripts/astro-target.mjs designer dev --force",
    "build": "astro build --force && node scripts/validate.mjs dist && node scripts/privacy-scan.mjs dist",
    "build:designer": "node scripts/astro-target.mjs designer build --force && node scripts/validate.mjs dist-designer",
    "preview": "astro preview",
    "check": "node scripts/validate.mjs",
    "schema": "node scripts/json-schema.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/starlight": "0.42.8",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "astro": "7.4.7",
    "codemirror": "6.0.2",
    "github-slugger": "2.0.0",
    "hast-util-to-html": "9.0.6",
    "js-yaml": "4.3.2",
    "mdast-util-directive": "3.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-gfm": "3.0.0",
    "unist-util-visit": "5.2.0"
  }
}
