<?xml version="1.0" encoding="utf-8"?>
<!-- This project uses public packages only. <clear /> drops any package sources inherited from
     user or machine NuGet config (e.g. a company feed), so restores never depend on them. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Every package comes from nuget.org; NuGet refuses to fetch it from anywhere else. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
